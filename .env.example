# Postgres connection strings.
# On Vercel: Storage tab -> Create Database -> Postgres (Neon).
# It sets these two automatically when you link the project; for local dev,
# copy both values from the Vercel dashboard or your own Neon/Supabase project.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# NextAuth
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
